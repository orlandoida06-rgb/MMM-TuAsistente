    );
    return null;
  }

  console.log(
    `[MMM-TuAsistente] Búsqueda YouTube: ${busqueda}`
  );

  try {

    const stdout = await new Promise((resolve, reject) => {

      execFile(
        ytDlpBin,
        [
          `ytsearch5:${busqueda}`,
          '--flat-playlist',
          '--print',
          '%(id)s|%(title)s',
          '--no-warnings',
          '--ignore-errors'
        ],
        {
          timeout: 30000,
          maxBuffer: 1024 * 1024
        },
        (error, stdout) => {

          if (!stdout || !stdout.trim()) {
            reject(
              error ||
              new Error('YouTube no devolvió resultados')
            );
            return;
          }

          resolve(stdout);
        }
      );

    });

    const resultados = stdout
      .split(/\r?\n/)
      .map(linea => linea.trim())
      .filter(Boolean);

    console.log(
      `[MMM-TuAsistente] Resultados YouTube: ${resultados.length}`
    );

    // Buscar el primer resultado con un ID válido
    for (const linea of resultados) {

      const separador = linea.indexOf('|');

      if (separador === -1) {
        continue;
      }

      const videoId =
        linea.substring(0, separador).trim();

      const titulo =
        linea.substring(separador + 1).trim();

      // ID normal de YouTube = 11 caracteres
