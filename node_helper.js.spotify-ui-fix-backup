  // ========================================================
  // SPOTIFY / LIBRESPOT - LEER EVENTOS
  // ========================================================

  startSpotifyEventWatcher() {

    const fs = require('fs');

    const eventFile =
      '/tmp/tuasistente-spotify-event.json';

    // ====================================================
    // SPOTIFY: estado de la última canción conocida
    // ====================================================

    this.spotifyTrackMetadata =
      this.spotifyTrackMetadata || {};

    this.spotifyLastEventTimestamp =
      this.spotifyLastEventTimestamp || '';

    // ====================================================
    // POLLING
    //
    // No usamos fs.watch porque el script de Librespot
    // escribe un temporal y después hace mv. En ese proceso
    // fs.watch puede perder track_changed.
    // ====================================================

    if (this.spotifyEventPoller) {
      clearInterval(this.spotifyEventPoller);
    }

    this.spotifyEventPoller = setInterval(() => {

      try {

        if (!fs.existsSync(eventFile)) {
          return;
        }

        const data =
          fs.readFileSync(eventFile, 'utf8').trim();

        if (!data) {
          return;
        }

        const event =
          JSON.parse(data);

        // Evitar procesar dos veces el mismo evento.
        const timestamp =
          String(event.timestamp || '');

        const eventKey =
          timestamp + ':' +
          String(event.event || '') + ':' +
          String(event.trackId || '') + ':' +
          String(event.positionMs || '');

        if (
          eventKey ===
          this.spotifyLastEventTimestamp
        ) {
          return;
        }

        this.spotifyLastEventTimestamp =
          eventKey;

        // ==================================================
        // Guardar metadatos de track_changed
        // ==================================================

        if (
          event.event === 'track_changed' &&
          event.name
        ) {

          this.spotifyTrackMetadata = {
            trackId: event.trackId || '',
            name: event.name || '',
            artists: event.artists || '',
            album: event.album || '',
            uri: event.uri || '',
            covers: event.covers || '',
            durationMs:
              event.durationMs || '0'
          };

        }

        // ==================================================
        // playing / paused pueden llegar sin metadatos.
        // Añadimos los de la última canción conocida.
        // ==================================================

        if (
          (
            event.event === 'playing' ||
            event.event === 'paused'
          ) &&
          this.spotifyTrackMetadata.name
        ) {

          Object.assign(
            event,
            this.spotifyTrackMetadata
          );

        }

        console.log(
          '[MMM-TuAsistente] Spotify evento:',
          event.event,
          event.name || '',
          event.artists || '',
          event.volume || ''
        );

        this.sendSocketNotification(
          'SPOTIFY_EVENT',
          event
        );

      } catch (error) {

        console.error(
          '[MMM-TuAsistente] Error leyendo evento Spotify:',
          error.message
        );

      }

    }, 250);

  },

