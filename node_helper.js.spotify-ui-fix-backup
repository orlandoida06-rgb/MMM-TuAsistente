      "wpctl get-volume @DEFAULT_AUDIO_SINK@",
      (error, stdout) => {

        if (error) {
          console.error(
            '[MMM-TuAsistente] No se pudo comprobar el mute al arrancar:',
            error.message
          );
          return;
