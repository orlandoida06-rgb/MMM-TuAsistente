  // ==========================================
  // BÚSQUEDA DE IMÁGENES
  // ==========================================
  async buscarImagen(query) {
    try {

      console.log(
        `[MMM-TuAsistente] Buscando imágenes en DuckDuckGo: ${query}`
      );

      const {
        imageSearch
      } = require('@mudbill/duckduckgo-images-api');

      /*
       * =========================================================
       * BÚSQUEDA DUCKDUCKGO
       * =========================================================
       */

      const resultados = await imageSearch({
        query: query,
        safe: true,
        iterations: 1,
        retries: 2
      });

      if (!Array.isArray(resultados) || resultados.length === 0) {

        console.error(
          `[MMM-TuAsistente] DuckDuckGo no devolvió imágenes para: ${query}`
        );

        return null;
      }

      console.log(
        `[MMM-TuAsistente] DuckDuckGo devolvió ${resultados.length} resultados`
      );

      /*
       * =========================================================
       * NORMALIZAR TEXTO
       * =========================================================
       */

      const normalizar = (texto) => {

        return String(texto || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^\w\s-]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();

      };

      const busqueda = normalizar(query);

      const palabras = busqueda
        .split(/\s+/)
        .filter(p => p.length >= 2);

      /*
       * =========================================================
       * SELECCIÓN DE LA IMAGEN MÁS RELEVANTE
       * =========================================================
       */

      let mejor = null;
      let mejorPuntuacion = -999;

      for (const resultado of resultados) {

        const titulo =
          resultado.title ||
          resultado.titulo ||
          '';

        const imageUrl =
          resultado.image ||
          resultado.imageUrl ||
          resultado.thumbnail ||
          '';

        const pageUrl =
          resultado.url ||
          resultado.pageUrl ||
          resultado.source ||
          '';

        if (!imageUrl) {
          continue;
        }

        if (
          !imageUrl.startsWith('http://') &&
          !imageUrl.startsWith('https://')
        ) {
          continue;
        }

        const texto = normalizar(
          `${titulo} ${pageUrl} ${imageUrl}`
        );

        let puntuacion = 0;

        /*
         * Coincidencias individuales.
         */

        for (const palabra of palabras) {

          if (texto.includes(palabra)) {
            puntuacion += 10;
          }

        }

        /*
         * Coincidencia de toda la búsqueda.
         */

        if (busqueda && texto.includes(busqueda)) {
          puntuacion += 30;
        }

        /*
         * El título tiene más peso que la URL.
         */

        const tituloNormalizado = normalizar(titulo);

        for (const palabra of palabras) {

          if (tituloNormalizado.includes(palabra)) {
            puntuacion += 15;
          }

        }

        /*
         * Penalizar resultados claramente extraños.
         */

        const dominiosMalos = [
          'animalia.bio',
          'hikingadventures.net',
          'walmartimages.com'
        ];

        for (const dominio of dominiosMalos) {

          if (texto.includes(dominio)) {
            puntuacion -= 50;
          }

        }

        if (puntuacion > mejorPuntuacion) {

          mejorPuntuacion = puntuacion;

          mejor = {
            url: imageUrl,
            titulo: titulo
          };

        }

      }

      /*
       * =========================================================
       * NO MOSTRAR RESULTADOS SIN RELEVANCIA
       * =========================================================
       */

      if (!mejor || mejorPuntuacion < 0) {

        console.error(
          `[MMM-TuAsistente] No hay una imagen suficientemente relevante para: ${query}`
        );

        return null;
      }

      console.log(
        `[MMM-TuAsistente] Imagen seleccionada (${mejorPuntuacion}): ${mejor.url}`
      );

      console.log(
        `[MMM-TuAsistente] Título: ${mejor.titulo}`
      );

      return mejor.url;

    } catch (error) {

      console.error(
        '[MMM-TuAsistente] Error buscando imagen con DuckDuckGo:',
        error.message
      );

      return null;
    }
  },

  async buscarWeb(query) {
    try {
      const axios = require('axios');

      console.log(`[MMM-TuAsistente] Buscando en Internet: ${query}`);

      const url =
        'https://html.duckduckgo.com/html/?q=' +
        encodeURIComponent(query);

      const response = await axios.get(url, {
        headers: {
          'User-Agent':
            'Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/537.36 Chrome/120 Safari/537.36'
        },
        timeout: 10000
      });

      const html = response.data;

      const results = [];

      const regex =
        /<a[^>]+class="result__a"[^>]*>(.*?)<\/a>[\s\S]*?<a[^>]+class="result__snippet"[^>]*>(.*?)<\/a>/g;

      let match;

      while (
        (match = regex.exec(html)) !== null &&
        results.length < 5
      ) {
        const title = match[1]
          .replace(/<[^>]+>/g, '')
          .replace(/&amp;/g, '&')
          .replace(/&quot;/g, '"')
          .replace(/&#x27;/g, "'")
          .trim();

        const snippet = match[2]
          .replace(/<[^>]+>/g, '')
          .replace(/&amp;/g, '&')
          .replace(/&quot;/g, '"')
          .replace(/&#x27;/g, "'")
          .trim();

        if (title) {
          results.push({
            title,
            snippet
          });
        }
      }

      console.log(
        `[MMM-TuAsistente] Resultados encontrados: ${results.length}`
      );

      this.sendSocketNotification(
        'WEB_RESULTS',
        results
      );

      return results;

    } catch (error) {

      console.error(
        '[MMM-TuAsistente] Error en búsqueda web:',
        error.message
      );

      this.sendSocketNotification(
        'WEB_RESULTS',
        []
      );

      return [];
    }
  },
